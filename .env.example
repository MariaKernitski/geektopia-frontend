# Copie para .env (não vai para o Git). Todas as variáveis do front começam com VITE_.

# Endereço da API do backend (termina em /api). Em produção: https://sua-api.exemplo.com/api
VITE_API_URL=http://localhost:3333/api

# true = confere o dígito verificador de CPF/CNPJ nos formulários (produção). Em desenvolvimento pode ficar vazio.
VITE_VALIDAR_DOCUMENTOS=
